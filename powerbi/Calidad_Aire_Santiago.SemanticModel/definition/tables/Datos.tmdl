	measure 'Mediana MP2.5' = MEDIAN(Datos[MP2_5])
		formatString: 0.0
		lineageTag: 10000001-0000-4000-8000-000000000001

	measure 'Promedio MP2.5' = AVERAGE(Datos[MP2_5])
		formatString: 0.0
		lineageTag: 10000001-0000-4000-8000-000000000002

	measure 'Norma Diaria (50)' = 50
		formatString: 0
		lineageTag: 10000001-0000-4000-8000-000000000003

	measure 'Total Dias Medidos' = COUNT(Datos[MP2_5])
		formatString: #,0
		lineageTag: 10000001-0000-4000-8000-000000000004

	measure 'Dias Sobre Norma' = COALESCE(SUM(Datos[Dia_Sobre_Norma]), 0)
		formatString: #,0
		lineageTag: 10000001-0000-4000-8000-000000000005

	measure '% Dias Sobre Norma' = DIVIDE([Dias Sobre Norma], [Total Dias Medidos], 0)
		formatString: 0.0%
		lineageTag: 10000001-0000-4000-8000-000000000006

	measure 'Dias Alerta' = COALESCE(SUM(Datos[Dia_Alerta]), 0)
		formatString: #,0
		lineageTag: 10000001-0000-4000-8000-000000000007

	measure 'Mediana Temperatura' = MEDIAN(Datos[Temperatura_C])
		formatString: 0.0
		lineageTag: 10000001-0000-4000-8000-000000000008

	measure 'Promedio Temperatura' = AVERAGE(Datos[Temperatura_C])
		formatString: 0.0
		lineageTag: 10000001-0000-4000-8000-000000000009

	measure 'Mediana Viento' = MEDIAN(Datos[Viento_ms])
		formatString: 0.00
		lineageTag: 10000001-0000-4000-8000-000000000010

	measure 'Promedio Viento' = AVERAGE(Datos[Viento_ms])
		formatString: 0.00
		lineageTag: 10000001-0000-4000-8000-000000000011

	measure 'Mediana Humedad' = MEDIAN(Datos[Humedad_pct])
		formatString: 0.0
		lineageTag: 10000001-0000-4000-8000-000000000012

